# ── Groq LLM ──────────────────────────────────────────────────────────
GROQ_API_KEY=gsk_YOUR_KEY_HERE
# Model used for chat answers (Phase 4 compares two models via this var)
GROQ_MODEL=llama3-8b-8192

# ── Evaluation / Judge ────────────────────────────────────────────────
# Model used as LLM judge in run_evals.py (can differ from GROQ_MODEL)
JUDGE_MODEL=llama3-8b-8192

# ── Retrieval mode ────────────────────────────────────────────────────
# Options: dense | hybrid | rerank | rewrite   (default: dense)
RETRIEVAL_MODE=dense

# ── Embedding model ───────────────────────────────────────────────────
# Options: hash (current fast hash) | minilm | bge-small
EMBEDDING_MODEL=hash

# ── ChromaDB ──────────────────────────────────────────────────────────
# Absolute or relative (from project root) path to ChromaDB data folder
CHROMA_PERSIST_DIR=./chroma_data

# ── Cost tracking (per 1M tokens, in USD) ─────────────────────────────
INPUT_TOKEN_COST_PER_1M=0.05
OUTPUT_TOKEN_COST_PER_1M=0.08
