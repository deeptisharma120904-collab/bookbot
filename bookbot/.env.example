# ── Groq LLM ──────────────────────────────────────────────────────────
GROQ_API_KEY=gsk_YOUR_KEY_HERE
# Primary model for chat responses (e.g. openai/gpt-oss-120b or qwen/qwen3.8-27b)
GROQ_MODEL=openai/gpt-oss-120b

# ── Evaluation / Judge ────────────────────────────────────────────────
# Model used as LLM judge in run_evals.py (compact 7B model prevents rate limits)
JUDGE_MODEL=allam-2-7b

# ── Retrieval mode ────────────────────────────────────────────────────
# Options:
#   dense    - pure cosine similarity on hash embeddings
#   hybrid   - BM25 sparse + dense cosine fused via Reciprocal Rank Fusion (RRF)
#   rewrite  - multi-turn follow-up query expansion + hybrid retrieval
RETRIEVAL_MODE=hybrid

# ── Storage ───────────────────────────────────────────────────────────
# Path to directory housing SQLite vector store (bookbot_vectors.db)
CHROMA_PERSIST_DIR=./chroma_data

# ── Token Cost tracking (per 1M tokens, in USD) ───────────────────────
INPUT_TOKEN_COST_PER_1M=0.59
OUTPUT_TOKEN_COST_PER_1M=0.79
